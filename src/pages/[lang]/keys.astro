---
import ComingSoon from '../../components/ComingSoon.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'pt' } },
    { params: { lang: 'en' } },
  ];
}

const pt = Astro.params.lang === 'pt';
---

<ComingSoon
  lang={pt ? 'pt' : 'en'}
  title={pt ? 'Identidade criptográfica' : 'Cryptographic identity'}
  alternatePath={pt ? '/en/keys' : '/pt/keys'}
/>
