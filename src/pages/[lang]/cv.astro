---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'pt' } },
    { params: { lang: 'en' } },
  ];
}

const lang = Astro.params.lang === 'pt' ? 'pt' : 'en';
const pt = lang === 'pt';

const entry = await getEntry('pages', `${lang}/cv`);

if (!entry) {
  throw new Error(`CV page not found: ${lang}`);
}

const { Content } = await render(entry);
---

<BaseLayout
  lang={lang}
  title={pt ? 'Currículo' : 'CV'}
  description={pt
    ? 'Currículo de João Vitor Fogaça de Oliveira: formação, experiências profissionais, projetos e habilidades.'
    : 'João Vitor Fogaça de Oliveira: education, professional experience, projects, and skills.'}
  alternatePath={pt ? '/en/cv' : '/pt/cv'}
>
  <main>
    <Content />
  </main>
</BaseLayout>
