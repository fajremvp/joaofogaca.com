---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'pt' } },
    { params: { lang: 'en' } },
  ];
}

const lang = Astro.params.lang === 'pt' ? 'pt' : 'en';
const pt = lang === 'pt';

const entry = await getEntry('pages', `${lang}/hub`);

if (!entry) {
  throw new Error(`Hub not found: ${lang}`);
}

const { Content } = await render(entry);
---

<BaseLayout
  lang={lang}
  title={pt ? 'Início' : 'Home'}
  description={pt
    ? 'Site pessoal de João Fogaça.'
    : 'Personal website of João Fogaça.'}
  alternatePath={pt ? '/en' : '/pt'}
>
  <main>
    <Content />
  </main>
</BaseLayout>
