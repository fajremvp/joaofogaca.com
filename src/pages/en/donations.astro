---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'en/donations');

if (!entry) {
  throw new Error('Donations page not found.');
}

const { Content } = await render(entry);
---

<BaseLayout
  lang="en"
  title="Donations"
  description="Support João Fogaça's projects and work with donations via Bitcoin, Lightning, Monero, or Pix."
  alternatePath="/pt/doacoes"
>
  <main>
    <Content />
  </main>
</BaseLayout>
