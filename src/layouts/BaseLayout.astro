---
import '../styles/base.css';

interface Props {
  lang: 'pt' | 'en';
  title: string;
  description?: string;
  alternatePath?: string;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  alternatePath,
  noindex = false,
} = Astro.props;

const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';

const canonical = new URL(
  Astro.url.pathname.replace(/\.html$/, ''),
  Astro.site
).toString();

const alternate = alternatePath
  ? new URL(alternatePath, Astro.site).toString()
  : undefined;

const otherLang = lang === 'pt' ? 'en' : 'pt-BR';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title} — João Fogaça</title>

    {description && (
      <meta name="description" content={description} />
    )}

    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}

    {alternate && !noindex && (
      <>
        <link
          rel="alternate"
          hreflang={htmlLang}
          href={canonical}
        />
        <link
          rel="alternate"
          hreflang={otherLang}
          href={alternate}
        />
      </>
    )}
  </head>

  <body>
    <slot />
  </body>
</html>
