---
import '../styles/base.css';

interface Props {
  lang: 'pt' | 'en';
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  noindex = false,
} = Astro.props;

const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';

const canonical = new URL(
  Astro.url.pathname,
  Astro.site
).toString();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title} — João Fogaça</title>

    {description && (
      <meta name="description" content={description} />
    )}

    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
  </head>

  <body>
    <slot />
  </body>
</html>
